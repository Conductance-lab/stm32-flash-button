{
    "name": "stm32-oneclick-flash",
    "displayName": "STM32 One-Click Build & Flash",
    "description": "%description%",
    "version": "1.0.4",
    "publisher": "conductance-lab",
    "license": "MIT",
    "icon": "icon.png",
    "galleryBanner": {
        "color": "#2563EB",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Conductance-lab/stm32-flash-button.git"
    },
    "homepage": "https://github.com/Conductance-lab/stm32-flash-button#readme",
    "bugs": {
        "url": "https://github.com/Conductance-lab/stm32-flash-button/issues"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "stm32",
        "flash",
        "build",
        "cmake",
        "stm32cubeprogrammer",
        "st-link",
        "one-click",
        "stm32cubeide",
        "arm-none-eabi",
        "一键编译烧录",
        "烧录",
        "嵌入式"
    ],
    "activationEvents": [
        "onCommand:stm32.flashAndBuild",
        "onCommand:stm32.flashOnly",
        "onCommand:stm32.diag",
        "onCommand:stm32.configureTools",
        "onCommand:stm32.selectBuildDir",
        "onCommand:stm32.openLog",
        "workspaceContains:**/*.ioc",
        "workspaceContains:**/CMakeLists.txt",
        "workspaceContains:**/CMakePresets.json"
    ],
    "main": "./extension.js",
    "l10n": "./l10n",
    "contributes": {
        "commands": [
            {
                "command": "stm32.flashAndBuild",
                "title": "%cmd.flashAndBuild.title%"
            },
            {
                "command": "stm32.diag",
                "title": "%cmd.diag.title%"
            },
            {
                "command": "stm32.configureTools",
                "title": "%cmd.configureTools.title%"
            },
            {
                "command": "stm32.selectBuildDir",
                "title": "%cmd.selectBuildDir.title%"
            },
            {
                "command": "stm32.openLog",
                "title": "%cmd.openLog.title%"
            },
            {
                "command": "stm32.flashOnly",
                "title": "%cmd.flashOnly.title%"
            }
        ],
        "keybindings": [
            {
                "command": "stm32.flashAndBuild",
                "key": "ctrl+alt+b",
                "mac": "cmd+alt+b"
            },
            {
                "command": "stm32.flashOnly",
                "key": "ctrl+alt+f",
                "mac": "cmd+alt+f"
            }
        ],
        "configuration": {
            "title": "%config.title%",
            "properties": {
                "stm32flash.programmer": {
                    "type": "string",
                    "default": "",
                    "description": "%config.programmer.description%"
                },
                "stm32flash.toolchainDirs": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": [],
                    "description": "%config.toolchainDirs.description%"
                },
                "stm32flash.extraPathDirs": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": [],
                    "description": "%config.extraPathDirs.description%"
                },
                "stm32flash.buildDir": {
                    "type": "string",
                    "default": "",
                    "description": "%config.buildDir.description%"
                },
                "stm32flash.programmerArgs": {
                    "type": "string",
                    "default": "-c port=SWD -w \"{elf}\" -v -rst",
                    "description": "%config.programmerArgs.description%"
                },
                "stm32flash.buildOnly": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.buildOnly.description%"
                },
                "stm32flash.clearBeforeRun": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.clearBeforeRun.description%"
                }
            }
        }
    }
}
